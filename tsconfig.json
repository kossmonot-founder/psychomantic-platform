{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@psychomantic/ui-react": ["vendor/ui-react/index.d.ts"],
      "@psychomantic/ui-react/styles.css": ["vendor/ui-react/ui-react.css"]
    }
  },
  "include": ["src"]
}
